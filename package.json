{
  "name": "recourse",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm build && turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run check-types",
    "check-types": "pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:indexes": "pnpm --filter api db:indexes",
    "env:check": "node --env-file=.env --import tsx scripts/verify-env.ts",
    "cloudinary:check": "pnpm --filter @recourse/config build && node --env-file=.env --import tsx scripts/cloudinary-live-check.ts",
    "groq:check": "pnpm --filter @recourse/config build && node --env-file=.env --import tsx scripts/groq-live-check.ts",
    "embedding:check": "pnpm --filter @recourse/config build && node --env-file=.env --import tsx scripts/embedding-live-check.ts",
    "tavily:check": "pnpm --filter @recourse/config build && node --env-file=.env --import tsx scripts/tavily-live-check.ts",
    "gmail:check": "pnpm --filter @recourse/config build && node --env-file=.env --import tsx scripts/gmail-live-check.ts",
    "atlas:indexes": "pnpm --filter @recourse/config build && node --env-file=.env --import tsx scripts/atlas-vector-indexes.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "web:dev": "pnpm --filter web dev",
    "api:dev": "pnpm --filter api... build && pnpm --filter api start:dev",
    "worker:dev": "pnpm --filter worker... build && pnpm --filter worker start:dev",
    "web:build": "pnpm --filter web build",
    "api:build": "pnpm --filter api build",
    "worker:build": "pnpm --filter worker build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
