{
  "name": "recourse",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- concurrently -k -n api,web -c blue,red \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:providers": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json node --env-file=.env --import tsx apps/api/scripts/provider-smoke.ts",
    "build": "pnpm --filter @recourse/shared build && pnpm --filter api build && pnpm --filter web build",
    "start": "dotenv -e .env -- concurrently -k -n api,web -c blue,red \"pnpm --filter api start\" \"pnpm --filter web start\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "concurrently": "9.2.1",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.1",
    "mongodb-memory-server": "11.0.1",
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.0.15"
  }
}
