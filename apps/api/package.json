{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./worker-domain": {
      "types": "./dist/worker-domain.module.d.ts",
      "require": "./dist/worker-domain.module.js",
      "default": "./dist/worker-domain.module.js"
    },
    "./queues": {
      "types": "./dist/modules/queues/queues.module.d.ts",
      "require": "./dist/modules/queues/queues.module.js",
      "default": "./dist/modules/queues/queues.module.js"
    },
    "./queue-constants": {
      "types": "./dist/modules/queues/queue.constants.d.ts",
      "require": "./dist/modules/queues/queue.constants.js",
      "default": "./dist/modules/queues/queue.constants.js"
    },
    "./redis-options": {
      "types": "./dist/modules/queues/redis-options.d.ts",
      "require": "./dist/modules/queues/redis-options.js",
      "default": "./dist/modules/queues/redis-options.js"
    },
    "./ai": {
      "types": "./dist/modules/ai/ai.module.d.ts",
      "require": "./dist/modules/ai/ai.module.js",
      "default": "./dist/modules/ai/ai.module.js"
    },
    "./procedure": {
      "types": "./dist/modules/procedure/procedure.module.d.ts",
      "require": "./dist/modules/procedure/procedure.module.js",
      "default": "./dist/modules/procedure/procedure.module.js"
    },
    "./email": {
      "types": "./dist/modules/email/email.module.d.ts",
      "require": "./dist/modules/email/email.module.js",
      "default": "./dist/modules/email/email.module.js"
    },
    "./security": {
      "types": "./dist/common/security/index.d.ts",
      "require": "./dist/common/security/index.js",
      "default": "./dist/common/security/index.js"
    },
    "./sentry": {
      "types": "./dist/sentry.d.ts",
      "require": "./dist/sentry.js",
      "default": "./dist/sentry.js"
    }
  },
  "files": [
    "dist",
    "nest-cli.json"
  ],
  "scripts": {
    "build": "nest build",
    "db:indexes": "node --env-file ../../.env --import tsx src/database/indexes.ts",
    "db:institutions": "node --env-file ../../.env --import tsx src/database/institutions.ts",
    "admin:grant": "node --env-file ../../.env --import tsx src/database/grant-admin.ts",
    "start": "node dist/main.js",
    "dev": "nest start --watch --env-file ../../.env",
    "start:prod": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@recourse/config": "workspace:*",
    "@recourse/contracts": "workspace:*",
    "@recourse/logger": "workspace:*",
    "@recourse/observability": "workspace:*",
    "@sentry/node": "10.70.0",
    "@tavily/core": "0.7.7",
    "argon2": "0.45.1",
    "bullmq": "6.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cloudinary": "2.10.0",
    "cookie-parser": "1.4.7",
    "groq-sdk": "1.5.0",
    "helmet": "8.3.0",
    "imapflow": "1.7.1",
    "ioredis": "6.0.0",
    "mammoth": "1.12.1",
    "mongoose": "9.9.2",
    "nodemailer": "9.0.5",
    "pdf-parse": "2.4.5",
    "postal-mime": "2.7.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@recourse/eslint-config": "workspace:*",
    "@recourse/typescript-config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "mongodb-memory-server": "11.2.0",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
