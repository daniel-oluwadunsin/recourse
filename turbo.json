{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "APP_ENV",
        "AUTH_COOKIE_SECURE",
        "AUTH_RATE_LIMIT_LIMIT",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "MONGODB_AUTO_INDEX",
        "MONGODB_DATABASE",
        "MONGODB_URI",
        "NODE_ENV",
        "RATE_LIMIT_STORAGE",
        "REDIS_URL",
        "REDIS_PREFIX",
        "WORKER_NAME"
      ]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
