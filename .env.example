# Application
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=recourse

# Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Gemini Developer API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Tavily Search + Extract
TAVILY_API_KEY=

# Cloudinary authenticated evidence storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Product limits and opt-in checks
MAX_UPLOAD_MB=15
LIVE_PROVIDER_TESTS=false
