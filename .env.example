# Application
NODE_ENV=development
APP_ENV=local
APP_VERSION=local
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_URL=http://localhost:4000
API_PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# Local Redis is the only infrastructure started by the development compose file.
# MongoDB Atlas is intentionally not replaced by a local database.
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=recourse:local:
QUEUE_CASE_CONCURRENCY=5
QUEUE_PROCEDURE_CONCURRENCY=3
QUEUE_EVIDENCE_CONCURRENCY=3
QUEUE_AI_CONCURRENCY=5
QUEUE_NOTIFICATION_CONCURRENCY=10
QUEUE_EXTERNAL_ACTION_CONCURRENCY=2
QUEUE_MAINTENANCE_CONCURRENCY=1
QUEUE_DISPATCH_INTERVAL_MS=5000
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=1000
QUEUE_COMPLETED_RETENTION=100
QUEUE_FAILED_RETENTION=1000
QUEUE_STALLED_INTERVAL_MS=30000
QUEUE_PROCEDURE_RATE_LIMIT_MAX=30
QUEUE_PROCEDURE_RATE_LIMIT_DURATION_MS=60000
QUEUE_AI_RATE_LIMIT_MAX=60
QUEUE_AI_RATE_LIMIT_DURATION_MS=60000
QUEUE_EXTERNAL_ACTION_RATE_LIMIT_MAX=5
QUEUE_EXTERNAL_ACTION_RATE_LIMIT_DURATION_MS=60000
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000

# MongoDB persistence. MONGODB_URI is required to run the API outside tests.
MONGODB_URI=
MONGODB_DATABASE=recourse
MONGODB_MAX_POOL_SIZE=
MONGODB_MIN_POOL_SIZE=
MONGODB_AUTO_INDEX=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# Cloudinary private raw asset storage. Credentials are created in the
# Cloudinary Console and must never be committed.
OBJECT_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=recourse
CLOUDINARY_UPLOAD_TTL_SECONDS=900
CLOUDINARY_DOWNLOAD_TTL_SECONDS=300
LIVE_CLOUDINARY_CHECK=false

# Evidence upload and parser safety limits.
UPLOAD_MAX_BYTES_PDF=26214400
UPLOAD_MAX_BYTES_DOCX=15728640
UPLOAD_MAX_BYTES_EMAIL=26214400
UPLOAD_MAX_BYTES_TEXT=2097152
UPLOAD_MAX_BYTES_IMAGE=15728640
UPLOAD_MAX_PAGES=100
UPLOAD_MAX_IMAGE_PIXELS=40000000

# Groq AI provider. The vision model is currently a preview model and is used
# only for explicit multimodal fallback; native evidence extraction runs first.
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_MODEL_VISION=qwen/qwen3.6-27b
GROQ_DEFAULT_REASONING_EFFORT=medium
GROQ_REQUEST_TIMEOUT_MS=30000
GROQ_MAX_RETRIES=2
GROQ_RETRY_BASE_DELAY_MS=500
TAVILY_API_KEY=

# Authentication and security. Secrets must be generated outside the repository.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d
JWT_ISSUER=recourse-api
JWT_AUDIENCE=recourse-web
AUTH_COOKIE_NAME=recourse_refresh
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_HASH_MEMORY_COST_KIB=19456
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_PARALLELISM=1
RATE_LIMIT_STORAGE=redis
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_LIMIT=10
TRUST_PROXY=false

# Optional observability settings. No telemetry provider is enabled by default.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=recourse-api

# Worker foundation
WORKER_NAME=recourse-worker
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_HEARTBEAT_STALE_MS=90000
SSE_HEARTBEAT_INTERVAL_MS=15000
SSE_RETRY_MS=5000
